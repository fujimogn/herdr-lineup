{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Asia/Tokyo)",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "enabledManagers": [
    "cargo",
    "github-actions",
    "rust-toolchain"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "automerge": false,
  "labels": [
    "renovate"
  ],
  "prConcurrentLimit": 5,
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Group compatible updates into a few weekly PRs",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "weekly compatible dependency updates"
    },
    {
      "description": "Keep Cargo requirement ranges and update resolved versions in the lockfile",
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Open each major update as its own PR after Dashboard approval",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Treat 0.x minor updates as major and approve each one",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the Rust toolchain fully pinned and approve every update",
      "matchManagers": [
        "rust-toolchain"
      ],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Update action pins in distributed workflows at their source",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/develop-tools.yml",
        ".github/workflows/ci-develop.yml",
        ".github/workflows/platform-check.yml"
      ],
      "enabled": false
    }
  ]
}
